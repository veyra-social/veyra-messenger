{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyra",
  "mainBinaryName": "Veyra",
  "version": "1.26.60",
  "identifier": "app.veyra.messenger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veyra",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost veyra-media: http://veyra-media.localhost https://veyra-media.localhost",
        "media-src": "'self' data: blob: asset: http://asset.localhost veyra-media: http://veyra-media.localhost https://veyra-media.localhost http://127.0.0.1:*",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 veyra-media: http://veyra-media.localhost https://veyra-media.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "versionCode": 1260060
    },
    "fileAssociations": [
      {
        "ext": ["vmb"],
        "mimeType": "application/vnd.veyra.backup",
        "name": "Veyra Backup",
        "role": "Editor",
        "exportedType": {
          "identifier": "app.veyra.messenger.backup",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": ["SystemConfiguration"],
      "infoPlist": "Info.ios.plist"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
